{
  "name": "planning",
  "private": true,
  "version": "0.1.0",
  "description": "Planning — suite de productivité 100% locale (notes, tâches, calendrier), Electron",
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">=20"
  },
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:baseline": "pnpm test && pnpm run build && pnpm test:e2e",
    "electron:dev": "concurrently -k \"vite\" \"wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "electron:start": "electron .",
    "dist": "pnpm run build && electron-builder --win"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.111.0",
    "@jarvis/action-registry": "workspace:*",
    "@jarvis/data-layer": "workspace:*",
    "@jarvis/design-system": "workspace:*",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "recharts": "^3.0.0",
    "xlsx": "^0.18.5",
    "zustand": "^5.0.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.1.10",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.5.2",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^36.4.0",
    "electron-builder": "^26.0.12",
    "jsdom": "^26.1.0",
    "tailwindcss": "^4.1.10",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.2.3",
    "wait-on": "^8.0.3"
  },
  "build": {
    "appId": "local.planning.app",
    "productName": "Planning",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "electron/**",
      "package.json",
      "!node_modules/${/*}"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "portable": {
      "artifactName": "Planning-${version}-portable.exe"
    }
  }
}
